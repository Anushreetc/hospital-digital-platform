VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional natural-language extraction via the supplied Edge Function.
VITE_ENABLE_AI_ASSISTANT=false
# Optional Azure Kannada/English speech via the same Edge Function.
VITE_ENABLE_CLOUD_SPEECH=false

# ElevenLabs voice agent (public agent ID only — never put the ElevenLabs API key in a VITE_ variable).
VITE_ELEVENLABS_AGENT_ID=
